# Copy to .env.local for local development with `vercel dev`. NEVER commit real values.
# On the live site, set these in Vercel -> Project -> Settings -> Environment Variables.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional
MONGODB_DB=chuka_marketplace
# Any random string; makes the hashed IP addresses used for rate limiting harder to reverse
IP_HASH_SALT=change-me
