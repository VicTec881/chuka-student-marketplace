# Copy to .env.local for local development with `vercel dev`. NEVER commit real values.
# On the live site, set these in Vercel -> Project -> Settings -> Environment Variables.

# Supabase project URL (Supabase dashboard -> Connect, or Project Settings)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SECRET key (Project Settings -> API Keys, starts with sb_secret_).
# It bypasses row level security: server only, never put it in front-end code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional: any random string; makes the hashed IP addresses used for rate limiting harder to reverse
IP_HASH_SALT=change-me

# Student sign-in emails (Brevo, free: https://www.brevo.com). MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
MAIL_FROM=marketplace@your-domain.example

# Optional: random string used to sign login cookies. If unset, derived from SUPABASE_SECRET_KEY.
SESSION_SECRET=change-me-to-a-long-random-string
